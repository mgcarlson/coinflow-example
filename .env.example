# Copy to .env and fill in ( .env is gitignored )
VITE_COINFLOW_MERCHANT_ID=
VITE_COINFLOW_ENV=sandbox
VITE_COINFLOW_API_KEY=
VITE_COINFLOW_AUTH_USER_ID=demo-shopper-1
VITE_COINFLOW_AUTH_SESSION_KEY=
VITE_COINFLOW_TX_APIKEY=
VITE_COINFLOW_TX_TOKENEX_ID=4582952996979143
# Optional: vaulted saved card token for POST /checkout/token (not a /tokenize token)
VITE_COINFLOW_SAVED_CARD_TOKEN=
# Legacy alias — same as SAVED_CARD_TOKEN if set
VITE_COINFLOW_CHECKOUT_CARD_TOKEN=
# Optional: override deterministic wallet derived from shopper id
VITE_COINFLOW_AUTH_WALLET=
# Optional: Solana RPC for CoinflowWithdraw (defaults to devnet)
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional: customPayInFees on POST /checkout/link (defaults: 50¢ fixed + 2.9% variable)
# VITE_CHECKOUT_PAYIN_FIXED_FEE_CENTS=50
# VITE_CHECKOUT_PAYIN_VARIABLE_FEE_PERCENT=2.9
# Use this domain in the browser — not 127.0.0.1. See public/.well-known/README.md
VITE_APP_ORIGIN=
# Hostname routed through Cloudflare Tunnel (npm run dev:tunnel)
VITE_TUNNEL_HOSTNAME=
