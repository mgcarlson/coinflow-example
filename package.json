{
  "name": "monkeytilt-coinflow-example",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dev:tunnel": "concurrently -k -n vite,tunnel -c yellow,cyan \"vite\" \"cloudflared tunnel --config tunnel/cloudflared.yml run\"",
    "tunnel:setup": "bash scripts/setup-tunnel.sh",
    "dev:mobile": "cd mobile && npm start",
    "dev:mobile:go": "cd mobile && npm run start:go",
    "dev:mobile:tunnel": "cd mobile && npm run start:tunnel",
    "dev:mobile:ios": "cd mobile && npm run ios",
    "install:mobile": "cd mobile && npm install"
  },
  "dependencies": {
    "@coinflowlabs/react": "^5.12.0",
    "@solana/web3.js": "^1.98.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.47.17"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
