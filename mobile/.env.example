# Copy from repo root .env — Expo reads EXPO_PUBLIC_* at build time
EXPO_PUBLIC_COINFLOW_MERCHANT_ID=
EXPO_PUBLIC_COINFLOW_ENV=sandbox
EXPO_PUBLIC_COINFLOW_API_KEY=
# Shopper id for Venmo checkout session key (GET /auth/session-key)
EXPO_PUBLIC_COINFLOW_AUTH_USER_ID=demo-shopper-1
# Optional: prefill iOS simulator wallet address field
EXPO_PUBLIC_COINFLOW_AUTH_WALLET=
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional: devnet (default) or mainnet-beta for Mobile Wallet Adapter chain
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
# Optional: override sandbox PayPal client-id for Venmo WebView checkout
# EXPO_PUBLIC_PAYPAL_CLIENT_ID=
# Optional: PayPal merchant-id for SDK (normally from GET /merchant/v2 → merchant.paypalMerchantId)
# EXPO_PUBLIC_PAYPAL_MERCHANT_ID=
# Venmo checkout opens the web app in Safari/Chrome (PayPal blocks in-app WebViews).
# Defaults to http://<your-mac-lan-ip>:5173 from Expo Metro host; set tunnel/Vercel if needed:
# EXPO_PUBLIC_VENMO_WEB_BASE_URL=https://your-tunnel.example.com
